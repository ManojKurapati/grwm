# ---------------------------------------------------------------------------
# GRWM AI — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# --- Convex (written automatically by `npx convex dev`) --------------------
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Context.dev ----------------------------------------------------------
# Powers real product extraction for the Missing Piece Engine and
# "Should I Buy This?". Get a key at https://context.dev/signup
# Must be set on the CONVEX deployment (server-side), never in the browser:
#   npx convex env set CONTEXT_DEV_API_KEY ctxt_secret_...
# Keeping it in .env.local too lets the local seeding scripts run.
CONTEXT_DEV_API_KEY=

# --- LLM (optional) -------------------------------------------------------
# GRWM's scoring engine is fully deterministic and runs without any LLM.
# If a key is present, GRWM additionally uses the model for:
#   - vision analysis of newly uploaded garments
#   - a final stylist "polish" pass on the winning outfit's explanation
# Without a key, both fall back to deterministic local implementations.
#   npx convex env set OPENAI_API_KEY sk-...
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Weather --------------------------------------------------------------
# Open-Meteo is used by default and requires NO API key.
